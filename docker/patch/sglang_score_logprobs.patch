+@pytest.mark.parametrize("count", [0, 32, 64, 128])
+def test_openai_chat_preserves_score_sampling_fields(count):
+    # Session v2 uses chat, so these fields must survive its Pydantic schema.
+    from sglang.srt.entrypoints.openai.protocol import ChatCompletionRequest
+
+    request = ChatCompletionRequest(
+        model="test",
+        messages=[{"role": "user", "content": "hello"}],
+        seed=17,
+        temperature=1.0,
+        top_p=1.0,
+        top_k=-1,
+        max_tokens=8,
+        logprobs=True,
+        top_logprobs=count or 32,
+        return_meta_info=True,
+        return_flat_raw_output_top_logprobs=True,
+        array_output_logprobs=True,
+        score_centering_samples=count,
+    )
+    params = request.to_sampling_params(stop=[], model_generation_config={})
+    assert params["array_output_logprobs"] is True
+    assert params["score_centering_samples"] == count
+    assert params["sampling_seed"] == 17
+    sampling = SamplingParams(**params)
+    sampling.normalize(None)
+    sampling.verify(256)
